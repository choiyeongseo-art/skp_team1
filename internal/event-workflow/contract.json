          "db": "notice_i18n + requirements_i18n + schedule_exceptions"
        },
        {
          "key": "requirements",
          "label": "한국 번호·본인인증·여권·앱·쿠폰 필요 조건",
          "type": "object",
          "db": "event_venues.*_requirement"
        }
      ]
    },
    {
      "key": "location",
