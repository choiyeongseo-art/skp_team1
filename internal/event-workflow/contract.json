      "fields": [
        {
          "key": "name",
          "label": "행사명",
          "type": "i18n",
          "db": "events.name_i18n"
        },
        {
          "key": "summary",
          "label": "한 줄 소개",
          "type": "i18n",
          "db": "events.summary_i18n"
        },
        {
          "key": "image",
          "label": "대표 이미지·출처·이용 조건",
          "type": "object",
          "db": "events.image_url + image_credit/source_url/license"
        },
        {
          "key": "event_type",
          "label": "진행 형태: popup/sale/experience/exhibition/festival/stay/other",
          "type": "text",
          "db": "events.event_type"
        },
        {
          "key": "audience",
          "label": "참여 대상",
          "type": "text",
          "db": "events.audience"
        }
      ]
    },
    {
      "key": "visit",
      "order": 20,
      "title": "방문 요약",
      "question": "내 여행 날짜에 갈 수 있나?",
      "display": "always",
      "fields": [
        {
          "key": "period",
          "label": "실제 방문 기간",
          "type": "range",
          "db": "event_venues.start_date/end_date; schedule_kind=visit"
        },
        {
          "key": "venue_summary",
          "label": "지점·층 요약",
          "type": "i18n",
          "db": "venues.name_i18n/floor_i18n"
        },
        {
          "key": "hours_summary",
          "label": "운영시간 요약·백화점/행사 기준 구분",
          "type": "i18n",
          "db": "event_venues.hours_note_i18n"
        },
        {
          "key": "admission",
          "label": "입장료 상태: free/paid/mixed/unknown/not_applicable",
          "type": "text",
          "db": "event_venues.admission_status"
        },
        {
          "key": "booking",
          "label": "예약 방식: required/optional/priority/not_required/unknown/not_applicable",
          "type": "text",
          "db": "event_venues.booking_status"
        },
        {
          "key": "foreign_booking",
          "label": "외국인 예약 가능 여부: available/unavailable/conditional/unknown/not_applicable",
          "type": "text",
          "db": "event_venues.foreign_booking_status"
        }
      ]
    },
    {
      "key": "alerts",
      "order": 30,
      "title": "방문 전 꼭 확인",
      "question": "헛걸음할 조건이 있나?",
