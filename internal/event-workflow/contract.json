        {
          "key": "transit",
          "label": "역·출구·도보 안내",
          "type": "i18n",
          "db": "venues.transit_i18n"
        },
        {
          "key": "accessibility",
          "label": "휠체어·유아 동반 등 확인 정보",
          "type": "i18n",
          "db": "venues.accessibility_status/accessibility_i18n"
        }
      ]
    },
    {
      "key": "admission",
      "order": 40,
      "title": "운영 시간",
      "question": "어떻게 입장하나?",
      "display": "always",
      "fields": [
        {
          "key": "opening_hours",
          "label": "요일별 운영시간·마지막 입장·접수 마감",
          "type": "rows:hours",
          "db": "opening_hours"
        },
        {
          "key": "exceptions",
          "label": "휴점·특별 영업",
