# Copy this file to .env.local. Never commit .env.local or actual server keys.
# Missing values leave authenticated/cloud features unconfigured; guest UI still runs.
BUSANDROP_AUTH_SUPABASE_URL=
BUSANDROP_AUTH_SUPABASE_PUBLISHABLE_KEY=
BUSANDROP_AUTH_GOOGLE_ENABLED=true
BUSANDROP_AUTH_APPLE_ENABLED=true
BUSANDROP_AUTH_EMAIL_ENABLED=true

# Tourism source project: server only, separate from the authentication project.
TOURISM_SUPABASE_URL=
TOURISM_SUPABASE_SERVICE_ROLE_KEY=

# Optional legacy KTO integration; the current local nearby API uses TOURISM_* above.
KTO_API_KEY=

# Vercel only: private Blob storage used for guest event saves.
# Local development uses .local/event-saves.json instead.
BLOB_READ_WRITE_TOKEN=

# Apple revocation: server-only secrets; never expose in auth-config or browser assets.
BUSANDROP_APPLE_CLIENT_ID=com.busandrop.web
BUSANDROP_APPLE_TEAM_ID=
BUSANDROP_APPLE_KEY_ID=
BUSANDROP_APPLE_PRIVATE_KEY=
