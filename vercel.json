{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/event-saves.js": {
      "maxDuration": 30,
      "includeFiles": "busan-drop/data/event-catalog.js"
    },
    "api/nearby-attractions.js": {
      "maxDuration": 60,
      "includeFiles": "busan-drop/data/store-locations.js"
    },
    "api/nearby-restaurants.js": {
      "maxDuration": 60,
      "includeFiles": "busan-drop/data/store-locations.js"
    },
    "api/tourism-translations.js": {
      "maxDuration": 60,
      "includeFiles": "busan-drop/data/store-locations.js"
    },
    "api/restaurant-translations.js": {
      "maxDuration": 60,
      "includeFiles": "busan-drop/data/store-locations.js"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/busandrop/login",
      "permanent": false
    },
    {
      "source": "/busandrop",
      "destination": "/busandrop/login",
      "permanent": false
    },
    {
      "source": "/home",
      "destination": "/busandrop/home",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/busandrop/auth-config",
      "destination": "/api/auth-config"
    },
    {
      "source": "/api/busandrop/restaurant-translations",
      "destination": "/api/restaurant-translations"
    },
    {
      "source": "/api/busandrop/tourism-translations",
      "destination": "/api/tourism-translations"
    },
    {
      "source": "/api/busandrop/nearby-restaurants",
      "destination": "/api/nearby-restaurants"
    },
    {
      "source": "/api/busandrop/nearby-attractions",
      "destination": "/api/nearby-attractions"
    },
    {
      "source": "/api/busandrop/event-saves",
      "destination": "/api/event-saves"
    },
    {
      "source": "/api/busandrop/event-saves/:eventId",
      "destination": "/api/event-saves?eventId=:eventId"
    },
    {
      "source": "/busandrop/login",
      "destination": "/busandrop/index.html"
    },
    {
      "source": "/busandrop/home",
      "destination": "/busandrop/index.html"
    },
    {
      "source": "/busandrop/stores",
      "destination": "/busandrop/index.html"
    },
    {
      "source": "/busandrop/drop-plan",
      "destination": "/busandrop/index.html"
    },
    {
      "source": "/busandrop/saved",
      "destination": "/busandrop/index.html"
    },
    {
      "source": "/busandrop/my",
      "destination": "/busandrop/index.html"
    },
    {
      "source": "/busandrop/auth/callback",
      "destination": "/busandrop/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/busandrop/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
